rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Atividades compartilhadas — somente autenticados, vínculo UID obrigatório
    match /atividades/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.criadaPor == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3
        && request.resource.data.concluida == false
        && request.resource.data.concluidaPor == null
        && request.resource.data.concluidaPorNome == null
        && request.resource.data.concluidaEm == null;

      // Update — reabertura travada, concluidaPor/PorNome/Em imutáveis após concluída,
      // e transição false->true exige UID autenticado (não atribuível a outro)
      allow update: if request.auth != null
        // 1) Nunca reabrir tarefa já concluída
        && !(resource.data.concluida == true && request.resource.data.concluida == false)
        // 2) Nunca alterar quem concluiu ou quando após concluída
        && !(resource.data.concluida == true && request.resource.data.concluidaPor != resource.data.concluidaPor)
        && !(resource.data.concluida == true && request.resource.data.concluidaPorNome != resource.data.concluidaPorNome)
        && !(resource.data.concluida == true && request.resource.data.concluidaEm != resource.data.concluidaEm)
        // 2b) criadaPor imutável
        && request.resource.data.criadaPor == resource.data.criadaPor
        // 3) Se concluir agora (false->true), exige UID autenticado e concluidaEm
        && (
          resource.data.concluida == true
          || request.resource.data.concluida == false
          || (
            request.resource.data.concluida == true
            && request.resource.data.concluidaPor is string
            && request.resource.data.concluidaPor == request.auth.uid
            && request.resource.data.concluidaPorNome is string
            && request.resource.data.concluidaEm != null
          )
        );

      allow delete: if request.auth != null;
    }

    // Bloqueia qualquer outra coleção por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
