rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // Atividades compartilhadas — somente usuários autenticados
    match /atividades/{id} {

      // Somente usuários autenticados podem visualizar
      allow read: if request.auth != null;

      // Criar atividade
      allow create: if request.auth != null
        && request.resource.data.criadaPor == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3
        && request.resource.data.concluida == false
        && request.resource.data.concluidaPor == null
        && request.resource.data.concluidaPorNome == null
        && request.resource.data.concluidaEm == null;

      // Atualizar atividade
      allow update: if request.auth != null

        // criador original não pode ser alterado
        && request.resource.data.criadaPor == resource.data.criadaPor

        // nunca reabrir uma atividade já concluída
        && !(resource.data.concluida == true
          && request.resource.data.concluida == false)

        // se já estava concluída, os dados da conclusão são imutáveis
        && !(resource.data.concluida == true
          && request.resource.data.concluidaPor != resource.data.concluidaPor)

        && !(resource.data.concluida == true
          && request.resource.data.concluidaPorNome != resource.data.concluidaPorNome)

        && !(resource.data.concluida == true
          && request.resource.data.concluidaEm != resource.data.concluidaEm)

        // enquanto estiver pendente, os dados de conclusão devem permanecer vazios
        && (
          request.resource.data.concluida == true
          || (
            request.resource.data.concluida == false
            && request.resource.data.concluidaPor == null
            && request.resource.data.concluidaPorNome == null
            && request.resource.data.concluidaEm == null
          )
        )

        // ao concluir, o UID deve ser exatamente o da conta autenticada
        && (
          resource.data.concluida == true
          || request.resource.data.concluida == false
          || (
            request.resource.data.concluida == true
            && request.resource.data.concluidaPor is string
            && request.resource.data.concluidaPor == request.auth.uid
            && request.resource.data.concluidaPorNome is string
            && request.resource.data.concluidaEm != null
          )
        );

      // Usuários autenticados podem excluir atividades
      allow delete: if request.auth != null;
    }

    // Bloqueia qualquer outra coleção/documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}